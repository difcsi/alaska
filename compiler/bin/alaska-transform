#!/usr/bin/env python3

import os
import sys
import argparse
import tempfile
import shutil
from pathlib import Path

local = Path(os.path.realpath(os.path.dirname(__file__))).parent
llvm_local = local.parent / "llvm"
opt_bin = llvm_local / "bin" / "opt"
llvm_link_bin = llvm_local / "bin" / "llvm-link"
llvm_dis_bin = llvm_local / "bin" / "llvm-dis"
os.environ["PATH"] = f"{local}/bin:{os.environ['PATH']}"
os.environ["LD_LIBRARY_PATH"] = f"{local}/lib:{os.environ.get('LD_LIBRARY_PATH', '')}"


parser = argparse.ArgumentParser(prog='alaska-transform', description='Applies alaska transformations to an input bitcode')


parser.add_argument('-o', dest='output', help='The destination file. Defaults to in-place.')
parser.add_argument('-b', '--baseline', action='store_true', help='Apply baseline transformations, do not insert translations')
parser.add_argument('input', help='The input .bc file to apply alaska transformations to.')

parser.add_argument('--disable-tracking', action='store_true')
parser.add_argument('--disable-hoisting', action='store_true')
parser.add_argument('--disable-inlining', action='store_true')

# "Yukon" stack-to-heap promotion: rewrite address-taken stack objects into
# halloc handles so a pycallocs/Python proxy can be built for them.
parser.add_argument('--stack-promote', action='store_true',
    help='Promote address-taken stack objects to the heap (Yukon).')
parser.add_argument('--heap-hints', dest='heap_hints', default=None, metavar='FILE',
    help='File listing functions whose pointer arguments force heap promotion of '
         'address-taken stack objects (implies --stack-promote). LinkPy emits this.')
promote_free = parser.add_mutually_exclusive_group()
promote_free.add_argument('--promote-free', dest='promote_free', action='store_true',
    default=None, help='Force hfree of promoted objects at function return.')
promote_free.add_argument('--no-promote-free', dest='promote_free', action='store_false',
    default=None, help='Suppress hfree of promoted objects (for Python-escaped '
                       'objects that outlive their C frame).')

# Keep-raw (non-escaping malloc/calloc kept on the libc allocator) is ON by
# default; --no-keep-raw disables it for this build (read by AlaskaReplacementPass).
parser.add_argument('--no-keep-raw', dest='no_keep_raw', action='store_true',
    help='Disable the keep-raw optimization (promote every malloc/calloc to a handle).')

args = parser.parse_args()

# The stack-promote pass reads these from the environment (inherited by opt).
if args.heap_hints is not None:
  os.environ['ALASKA_HEAP_HINTS'] = os.path.realpath(args.heap_hints)
  args.stack_promote = True
if os.environ.get('ALASKA_HEAP_HINTS') or os.environ.get('ALASKA_STACK_PROMOTE'):
  args.stack_promote = True
if args.promote_free is not None:
  os.environ['ALASKA_STACK_PROMOTE_FREE'] = '1' if args.promote_free else '0'
if args.no_keep_raw:
  os.environ['ALASKA_NO_KEEP_RAW'] = '1'

# print(args)

if args.output is None:
  args.output = args.input


bitcode = args.output

def exec(cmd):
  # print('exec |', cmd)
  res = os.system(cmd)
  if res != 0:
    exit()

tempdir = tempfile.mkdtemp(prefix='alaska_')


exec(f'{opt_bin} --strip-debug {local}/lib/alaska_stub.bc -o {tempdir}/stub.bc')
exec(f'{opt_bin} --strip-debug {local}/lib/alaska_translate.bc -o {tempdir}/translate.bc')

if not args.baseline:
  exec(f'{llvm_link_bin} {args.input} --internalize {tempdir}/stub.bc -o {bitcode}')
else:
  if args.input != bitcode:
    shutil.copy(args.input, bitcode)

def run_passes(passes):
  for p in passes:
    before = f'{tempdir}/before-{p}.bc'
    after = f'{tempdir}/after-{p}.bc'
    shutil.copy(bitcode, before)
    exec(f'{opt_bin} --load-pass-plugin={local}/lib/Alaska.so --passes={p} {before} -o {after}')
    shutil.copy(after, bitcode)


passes = []


# exec(f'opt {bitcode} -o {bitcode} -O3')
# exec(f'opt {bitcode} -o {bitcode} -basic-aa -mergereturn --break-crit-edges -loop-simplify -lcssa -indvars -mem2reg -simplifycfg-sink-common=false -licm -instnamer')
exec(f'{opt_bin} {bitcode} -o {bitcode} -passes=mergereturn,break-crit-edges,loop-simplify,lcssa,indvars,mem2reg,instnamer')


run_passes(['alaska-prepare'])

# Now add the passes in the order they need to be (if we aren't compiling for baseline)
if not args.baseline:
  # Yukon stack-to-heap promotion must run after malloc replacement and before
  # translation: the halloc calls it introduces are picked up as translation
  # roots, whereas the allocas they replace would never be translated.
  promote = ['alaska-stack-promote'] if args.stack_promote else []
  if not args.disable_hoisting:
    run_passes(['alaska-replace'] + promote + ['alaska-translate'])
  else:
    run_passes(['alaska-replace'] + promote + ['alaska-translate-nohoist'])


  # run_passes(['alaska-translate'])
  exec(f'{llvm_link_bin} {bitcode} --internalize {tempdir}/translate.bc -o {bitcode}')
  passes.append('alaska-escape')

  if not args.disable_tracking:
    passes.append('alaska-tracking')

  passes.append('alaska-lower')

  # Add refcount passes after lowering (when pointers are converted to handles).
  # Whether reference counting is compiled in is decided at configure time
  # (ALASKA_ENABLE_REFCOUNT); the value below is substituted by CMake. When the
  # feature is off these passes are not even registered in the plugin, so they
  # must not be requested here.
  ALASKA_ENABLE_REFCOUNT = @ALASKA_ENABLE_REFCOUNT_PY@
  if ALASKA_ENABLE_REFCOUNT:
    passes.append('alaska-refcount-inc')
    passes.append('alaska-refcount-dec')

  # Run lowering again as a final cleanup to ensure marker calls are removed
  # even if earlier passes introduced new alaska.* markers.
  passes.append('alaska-lower')

  # Inlining messes up reference counting (for now), so skip it
  if not args.disable_inlining and False:
    passes.append('alaska-inline')


run_passes(passes)
# exec(f'opt {bitcode} -o {bitcode} --mem2reg -lcssa -gvn --instnamer -sink -simplifycfg -dce')
exec(f'{llvm_dis_bin} {args.output}')
